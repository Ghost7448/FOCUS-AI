# MySQL connection (MYSQL_URL is optional when individual variables are set)
MYSQL_DATABASE=focus_ai
MYSQL_URL=
MYSQLHOST=localhost
MYSQLPASSWORD=
MYSQLPORT=3306
MYSQLUSER=root
DB_SSL=false
DB_CONNECTION_LIMIT=10

APP_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=true

# Resend email delivery
RESEND_API_KEY=
# Example: FOCUS AI <no-reply@your-verified-domain.com>
RESEND_FROM=

# Set these only in your local shell when creating the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
