# MySQL connection (use separate variables instead of a DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=focus_ai
DB_SSL=false
DB_CONNECTION_LIMIT=10

APP_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=true

# Resend email delivery
RESEND_API_KEY=
# Example: FOCUS AI <no-reply@your-verified-domain.com>
RESEND_FROM=

# Set these only in your local shell when creating the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
