# MySQL connection (MYSQL_URL is optional when individual variables are set)
MYSQL_DATABASE=focus_ai
MYSQL_URL=
MYSQLHOST=localhost
MYSQLPASSWORD=
MYSQLPORT=3306
MYSQLUSER=root
DB_SSL=false
DB_CONNECTION_LIMIT=10

APP_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=true

# Primary AI provider (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TUTOR_MODEL=gemini-3.8-flash
# Default daily primary-provider cap; resets at midnight Africa/Cairo
GEMINI_DAILY_LIMIT=20

# Automatic fallback AI provider (server-side only)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Sendliberty transactional email (connect Gmail in Sendliberty, then create an API key)
SL_API_KEY=
# Example: FOCUS AI <your-connected-gmail@gmail.com>
SL_FROM=

# Set these only in your local shell when creating the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
