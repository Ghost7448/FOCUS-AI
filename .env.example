DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/focus_ai
# Or use DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME instead.
DB_SSL=false
DB_CONNECTION_LIMIT=10
APP_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=true
# For local-only testing you may set EMAIL_VERIFICATION_REQUIRED=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set these only in your local shell when creating the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
